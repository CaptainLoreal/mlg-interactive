# ─────────────────────────────────────────────────────────────────────
# Canonical host — send the bare domain to www.
#
# Both hosts serve 200 from this same docroot, so every page is reachable
# at two URLs. <link rel="canonical"> already points at www, so Google
# consolidates them, but relying on canonical alone leaves the duplicate
# reachable, splits any inbound links between two hosts, and depends on
# a hint rather than an instruction. A 301 settles it.
#
# No redirect loop is possible: the condition matches ONLY the bare host,
# and the target is www, which cannot satisfy it.
#
# Guarded by <IfModule>: if mod_rewrite isn't loaded the block is skipped
# rather than 500-ing the whole site.
# ─────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Contact-form verifier: proxy /api/contact to the Node service on :3005
  # (Cloudflare Turnstile check, then forward to Power Automate). Same origin,
  # so the browser needs no CORS and the Power Automate URL never ships to the
  # client. Must come BEFORE the host redirect so it isn't bounced to www first.
  # The [P] flag needs mod_proxy; verified available on this host.
  RewriteRule ^api/contact(/.*)?$ http://127.0.0.1:3005/api/contact$1 [P,L]

  # Umami analytics: proxy /stats to the self-hosted instance on :3006.
  # Serving it from our own origin (rather than a third-party domain) means
  # the tracker script at /stats/script.js is first-party, so ad blockers —
  # which work from blocklists of known third-party analytics hosts — do not
  # strip it. Umami is built with BASE_PATH=/stats so its own links match.
  # Like the rule above this must precede the host redirect, and [P] needs
  # mod_proxy (already in use for /api/contact).
  RewriteRule ^stats(/.*)?$ http://127.0.0.1:3006/stats$1 [P,L]


  # ───────────────────────────────────────────────────────────────
  # 301 redirects: old-site URLs (pre-2026 relaunch used /en/<slug>
  # paths without .html). Preserves rankings and inbound links.
  # Specific pages first, then team profiles, then catch-alls.
  # ───────────────────────────────────────────────────────────────
  RewriteRule ^en/about\-us/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/brandon\-hall\-award/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/clients/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/coaching/?$ https://www.munichleadership.com/coaching-sparring.html [R=301,L]
  RewriteRule ^en/consulting/?$ https://www.munichleadership.com/leadership-development.html [R=301,L]
  RewriteRule ^en/contact\-us/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/disclaimer/?$ https://www.munichleadership.com/disclaimer.html [R=301,L]
  RewriteRule ^en/four\-factors\-of\-change/?$ https://www.munichleadership.com/cultural-transformation.html [R=301,L]
  RewriteRule ^en/home/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/how\-we\-work/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/is\-your\-team\-a\-winning\-team/?$ https://www.munichleadership.com/team-development.html [R=301,L]
  RewriteRule ^en/mission\-and\-vision/?$ https://www.munichleadership.com/future-of-leadership.html [R=301,L]
  RewriteRule ^en/mlg\-facts\-and\-figures/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/mlg\-learning\-partners/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/mlg\-network/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/quality\-counts/?$ https://www.munichleadership.com/our-values.html [R=301,L]
  RewriteRule ^en/services/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/team/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/the\-leading\-brain/?$ https://www.munichleadership.com/ [R=301,L]
  RewriteRule ^en/training/?$ https://www.munichleadership.com/leadership-development.html [R=301,L]
  RewriteRule ^en/transformation/?$ https://www.munichleadership.com/cultural-transformation.html [R=301,L]
  RewriteRule ^en/values/?$ https://www.munichleadership.com/our-values.html [R=301,L]
  RewriteRule ^en/team/angelita\-orbea/?$ https://www.munichleadership.com/team-orbea.html [R=301,L]
  RewriteRule ^en/team/biran\-yilancioglu/?$ https://www.munichleadership.com/team-yilancioglu.html [R=301,L]
  RewriteRule ^en/team/christine\-xue/?$ https://www.munichleadership.com/team-xue.html [R=301,L]
  RewriteRule ^en/team/christoph\-seidenfus/?$ https://www.munichleadership.com/team-seidenfus.html [R=301,L]
  RewriteRule ^en/team/deanna\-banks\-phd/?$ https://www.munichleadership.com/team-banks.html [R=301,L]
  RewriteRule ^en/team/doreen\-koehler/?$ https://www.munichleadership.com/team-koehler.html [R=301,L]
  RewriteRule ^en/team/dr\-hans\-w\-hagemann/?$ https://www.munichleadership.com/team-hagemann.html [R=301,L]
  RewriteRule ^en/team/dr\-roland\-fichtel/?$ https://www.munichleadership.com/team-fichtel.html [R=301,L]
  RewriteRule ^en/team/dr\-ulrich\-albrecht\-frueh/?$ https://www.munichleadership.com/team-albrecht-frueh.html [R=301,L]
  RewriteRule ^en/team/gabor\-holch/?$ https://www.munichleadership.com/team-holch.html [R=301,L]
  RewriteRule ^en/team/glyn\-jones/?$ https://www.munichleadership.com/team-jones.html [R=301,L]
  RewriteRule ^en/team/hubert\-heindl/?$ https://www.munichleadership.com/team-heindl.html [R=301,L]
  RewriteRule ^en/team/jane\-millar/?$ https://www.munichleadership.com/team-millar.html [R=301,L]
  RewriteRule ^en/team/juergen\-hessenauer/?$ https://www.munichleadership.com/team-hessenauer.html [R=301,L]
  RewriteRule ^en/team/kate\-klawitter/?$ https://www.munichleadership.com/team-klawitter.html [R=301,L]
  RewriteRule ^en/team/klaus\-duerrbeck/?$ https://www.munichleadership.com/team-duerrbeck.html [R=301,L]
  RewriteRule ^en/team/margaret\-a\-sanchez/?$ https://www.munichleadership.com/team-sanchez.html [R=301,L]
  RewriteRule ^en/team/margarita\-aguilar/?$ https://www.munichleadership.com/team-aguilar.html [R=301,L]
  RewriteRule ^en/team/mark\-guo/?$ https://www.munichleadership.com/team-guo.html [R=301,L]
  RewriteRule ^en/team/martina\-bohnenstiel/?$ https://www.munichleadership.com/team-bohnenstiel.html [R=301,L]
  RewriteRule ^en/team/matt\-beadle/?$ https://www.munichleadership.com/team-beadle.html [R=301,L]
  RewriteRule ^en/team/michael\-knieling/?$ https://www.munichleadership.com/team-knieling.html [R=301,L]
  RewriteRule ^en/team/monica\-ambrosini/?$ https://www.munichleadership.com/team-ambrosini.html [R=301,L]
  RewriteRule ^en/team/natalie\-rosengart/?$ https://www.munichleadership.com/team-rosengart.html [R=301,L]
  RewriteRule ^en/team/paige\-k\-graham\-phd/?$ https://www.munichleadership.com/team-graham.html [R=301,L]
  RewriteRule ^en/team/patti\-lo/?$ https://www.munichleadership.com/team-lo.html [R=301,L]
  RewriteRule ^en/team/serdar\-lale/?$ https://www.munichleadership.com/team-lale.html [R=301,L]
  RewriteRule ^en/team/simone\-albrecht/?$ https://www.munichleadership.com/team-albrecht-s.html [R=301,L]
  RewriteRule ^en/team/stephen\-yong/?$ https://www.munichleadership.com/team-yong.html [R=301,L]
  RewriteRule ^en/team/susanne\-rentel/?$ https://www.munichleadership.com/team-rentel.html [R=301,L]
  RewriteRule ^en/team/teresa\-ramos/?$ https://www.munichleadership.com/team-ramos.html [R=301,L]
  RewriteRule ^en/team/thomas\-ganslmayr/?$ https://www.munichleadership.com/team-ganslmayr.html [R=301,L]
  RewriteRule ^en/team/thomas\-kraen/?$ https://www.munichleadership.com/team-kraen.html [R=301,L]
  RewriteRule ^en/team/vivianne\-naeslund/?$ https://www.munichleadership.com/team-naeslund.html [R=301,L]
  # blog and anything else under /en/ → homepage
  RewriteRule ^en(/.*)?$ https://www.munichleadership.com/ [R=301,L]
  # old German URLs (/de/<slug> without .html) that don't exist as files → German homepage
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^de/.+$ https://www.munichleadership.com/de/ [R=301,L]

  RewriteCond %{HTTP_HOST} ^munichleadership\.com$ [NC]
  RewriteRule ^ https://www.munichleadership.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ─────────────────────────────────────────────────────────────────────
# Static asset caching (Apache / Hetzner).
#
# PageSpeed flagged ~2.1 MB of repeat-visit savings from missing cache
# lifetimes. CSS/JS/fonts are safe to cache for a year because they are
# cache-busted via a ?v=N query string (styles.min.css?v=622, app.min.js
# ?v=256) — a new version is a new URL, so it always refetches.
#
# Images are NOT globally version-stamped, so they get a shorter 30-day
# TTL; when an image must update sooner, add a ?v=N to its reference
# (as done for assets/team/christine-westermayr.jpg?v=3).
#
# HTML always revalidates so content deploys appear immediately.
#
# Every block is wrapped in <IfModule> — if the module isn't loaded the
# directives are skipped rather than erroring the site.
# ─────────────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/font-woff2   "access plus 1 year"
  ExpiresByType image/webp               "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/gif                "access plus 30 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/x-icon             "access plus 30 days"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Versioned, immutable assets (?v=N busts them)
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images / icons — 30 days
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML + feeds must revalidate so deploys show up right away
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # The proxied Umami app (/stats) must NOT inherit the year-long immutable
  # rule above: /stats/script.js ends in .js and would otherwise be pinned in
  # browser caches for a year, so tracker updates would never reach visitors.
  # Umami sends its own sensible caching; a short TTL here is enough.
  <IfModule mod_setenvif.c>
    <If "%{REQUEST_URI} =~ m#^/stats#">
      Header unset Cache-Control
      Header set Cache-Control "public, max-age=3600"
    </If>
  </IfModule>
</IfModule>
