# ─────────────────────────────────────────────────────────────────────
# Canonical host — send the bare domain to www.
#
# Both hosts serve 200 from this same docroot, so every page is reachable
# at two URLs. <link rel="canonical"> already points at www, so Google
# consolidates them, but relying on canonical alone leaves the duplicate
# reachable, splits any inbound links between two hosts, and depends on
# a hint rather than an instruction. A 301 settles it.
#
# No redirect loop is possible: the condition matches ONLY the bare host,
# and the target is www, which cannot satisfy it.
#
# Guarded by <IfModule>: if mod_rewrite isn't loaded the block is skipped
# rather than 500-ing the whole site.
# ─────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Contact-form verifier: proxy /api/contact to the Node service on :3005
  # (Cloudflare Turnstile check, then forward to Power Automate). Same origin,
  # so the browser needs no CORS and the Power Automate URL never ships to the
  # client. Must come BEFORE the host redirect so it isn't bounced to www first.
  # The [P] flag needs mod_proxy; verified available on this host.
  RewriteRule ^api/contact(/.*)?$ http://127.0.0.1:3005/api/contact$1 [P,L]

  RewriteCond %{HTTP_HOST} ^munichleadership\.com$ [NC]
  RewriteRule ^ https://www.munichleadership.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ─────────────────────────────────────────────────────────────────────
# Static asset caching (Apache / Hetzner).
#
# PageSpeed flagged ~2.1 MB of repeat-visit savings from missing cache
# lifetimes. CSS/JS/fonts are safe to cache for a year because they are
# cache-busted via a ?v=N query string (styles.min.css?v=622, app.min.js
# ?v=256) — a new version is a new URL, so it always refetches.
#
# Images are NOT globally version-stamped, so they get a shorter 30-day
# TTL; when an image must update sooner, add a ?v=N to its reference
# (as done for assets/team/christine-westermayr.jpg?v=3).
#
# HTML always revalidates so content deploys appear immediately.
#
# Every block is wrapped in <IfModule> — if the module isn't loaded the
# directives are skipped rather than erroring the site.
# ─────────────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType text/javascript          "access plus 1 year"
  ExpiresByType font/woff2               "access plus 1 year"
  ExpiresByType application/font-woff2   "access plus 1 year"
  ExpiresByType image/webp               "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/gif                "access plus 30 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/x-icon             "access plus 30 days"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Versioned, immutable assets (?v=N busts them)
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images / icons — 30 days
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML + feeds must revalidate so deploys show up right away
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
