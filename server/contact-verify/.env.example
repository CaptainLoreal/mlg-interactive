# Copy to ~/contact-verify/.env on the server and fill in. chmod 600.
# NEVER commit the real .env — the secret must stay off GitHub and out of the browser.

PORT=3005

# Cloudflare Turnstile SECRET key (server-side only).
# Get it: dash.cloudflare.com -> Turnstile -> your widget -> "Secret Key".
# Empty = fail-closed: every submission is rejected (safe default before go-live).
# Cloudflare test secrets: 1x0000000000000000000000000000000AA (always pass),
#                          2x0000000000000000000000000000000AA (always fail).
TURNSTILE_SECRET=

# Power Automate webhook the verified submission is forwarded to (server-side,
# so this URL no longer ships to the browser).
POWER_AUTOMATE_URL=
